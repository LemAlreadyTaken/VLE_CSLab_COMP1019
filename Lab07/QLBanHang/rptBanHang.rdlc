<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2005/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <DataSources>
    <DataSource Name="DummyDataSource">
      <ConnectionProperties>
        <ConnectString />
        <DataProvider>SQL</DataProvider>
      </ConnectionProperties>
      <rd:DataSourceID>7c2a5d1e-3b4f-4a6c-9e18-0d5f2b9a1c33</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <ReportParameters>
    <ReportParameter Name="txtHoTenKH">
      <DataType>String</DataType>
      <AllowBlank>true</AllowBlank>
      <Prompt>txtHoTenKH</Prompt>
    </ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="dsHangChonMua">
      <Query>
        <DataSourceName>DummyDataSource</DataSourceName>
        <CommandText />
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="MaHH">
          <DataField>MaHH</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="TenHH">
          <DataField>TenHH</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="SoLuong">
          <DataField>SoLuong</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="DonGia">
          <DataField>DonGia</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ThanhTien">
          <DataField>ThanhTien</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <Language>vi-VN</Language>
  <Width>17.5cm</Width>
  <PageWidth>21cm</PageWidth>
  <PageHeight>29.7cm</PageHeight>
  <LeftMargin>1.5cm</LeftMargin>
  <RightMargin>1.5cm</RightMargin>
  <TopMargin>1.5cm</TopMargin>
  <BottomMargin>1.5cm</BottomMargin>
  <Body>
    <Height>8cm</Height>
    <ReportItems>
      <Textbox Name="txtTieuDe">
        <Top>0cm</Top>
        <Left>0cm</Left>
        <Width>17.5cm</Width>
        <Height>1cm</Height>
        <Value>HÓA ĐƠN BÁN HÀNG</Value>
        <Style>
          <FontSize>16pt</FontSize>
          <FontWeight>Bold</FontWeight>
          <TextAlign>Center</TextAlign>
        </Style>
      </Textbox>
      <Textbox Name="txtKhachHang">
        <Top>1.4cm</Top>
        <Left>0cm</Left>
        <Width>17.5cm</Width>
        <Height>0.8cm</Height>
        <Value>="Họ tên người mua hàng: " &amp; Parameters!txtHoTenKH.Value</Value>
        <Style>
          <FontSize>11pt</FontSize>
          <FontWeight>Bold</FontWeight>
        </Style>
      </Textbox>
      <Table Name="tblHangHoa">
        <DataSetName>dsHangChonMua</DataSetName>
        <Top>2.6cm</Top>
        <Left>0cm</Left>
        <Width>17.5cm</Width>
        <TableColumns>
          <TableColumn><Width>2.5cm</Width></TableColumn>
          <TableColumn><Width>6cm</Width></TableColumn>
          <TableColumn><Width>3cm</Width></TableColumn>
          <TableColumn><Width>2.5cm</Width></TableColumn>
          <TableColumn><Width>3.5cm</Width></TableColumn>
        </TableColumns>
        <Header>
          <TableRows>
            <TableRow>
              <Height>0.7cm</Height>
              <TableCells>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="hMaHH">
                      <Value>Mã hàng</Value>
                      <Style><FontWeight>Bold</FontWeight><BackgroundColor>LightGrey</BackgroundColor><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="hTenHH">
                      <Value>Tên hàng hóa</Value>
                      <Style><FontWeight>Bold</FontWeight><BackgroundColor>LightGrey</BackgroundColor><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="hDonGia">
                      <Value>Đơn giá</Value>
                      <Style><FontWeight>Bold</FontWeight><BackgroundColor>LightGrey</BackgroundColor><TextAlign>Right</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="hSoLuong">
                      <Value>Số lượng</Value>
                      <Style><FontWeight>Bold</FontWeight><BackgroundColor>LightGrey</BackgroundColor><TextAlign>Right</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="hThanhTien">
                      <Value>Thành tiền</Value>
                      <Style><FontWeight>Bold</FontWeight><BackgroundColor>LightGrey</BackgroundColor><TextAlign>Right</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Header>
        <Details>
          <TableRows>
            <TableRow>
              <Height>0.6cm</Height>
              <TableCells>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="MaHH">
                      <Value>=Fields!MaHH.Value</Value>
                      <Style><TextAlign>Right</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="TenHH">
                      <Value>=Fields!TenHH.Value</Value>
                      <Style><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="DonGia">
                      <Value>=Fields!DonGia.Value</Value>
                      <Style><Format>#,##0</Format><TextAlign>Right</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="SoLuong">
                      <Value>=Fields!SoLuong.Value</Value>
                      <Style><TextAlign>Right</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
                <TableCell>
                  <ReportItems>
                    <Textbox Name="ThanhTien">
                      <Value>=Fields!ThanhTien.Value</Value>
                      <Style><Format>#,##0</Format><TextAlign>Right</TextAlign><BorderStyle><Default>Solid</Default></BorderStyle><PaddingLeft>2pt</PaddingLeft><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Details>
        <Footer>
          <TableRows>
            <TableRow>
              <Height>0.8cm</Height>
              <TableCells>
                <TableCell>
                  <ColSpan>5</ColSpan>
                  <ReportItems>
                    <Textbox Name="txtTongCong">
                      <Value>="Tổng tiền: " &amp; Format(Sum(Fields!ThanhTien.Value), "#,##0")</Value>
                      <Style><FontSize>12pt</FontSize><FontWeight>Bold</FontWeight><TextAlign>Right</TextAlign><PaddingRight>2pt</PaddingRight></Style>
                    </Textbox>
                  </ReportItems>
                </TableCell>
              </TableCells>
            </TableRow>
          </TableRows>
        </Footer>
      </Table>
    </ReportItems>
  </Body>
</Report>
